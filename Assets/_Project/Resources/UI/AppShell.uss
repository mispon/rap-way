.app-shell {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--rw-color-graphite-950);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.screen--centered {
    padding: var(--rw-space-lg);
    justify-content: center;
    align-items: center;
}

.screen--splash,
.screen--hud {
    background-color: var(--rw-color-graphite-950);
}

.screen--menu {
    padding: var(--rw-space-xl) var(--rw-space-lg);
    justify-content: center;
    align-items: center;
    background-color: var(--rw-color-charcoal-850);
}

.splash-mark {
    width: 96px;
    height: 96px;
    margin-bottom: var(--rw-space-lg);
    justify-content: center;
    align-items: center;
    background-color: var(--rw-color-coral-500);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: var(--rw-color-paper-100);
    border-right-color: var(--rw-color-paper-100);
    border-bottom-color: var(--rw-color-paper-100);
    border-left-color: var(--rw-color-paper-100);
}

.splash-mark__text,
.menu-poster-strip__text {
    color: var(--rw-color-graphite-950);
    font-size: var(--rw-font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.brand-title {
    margin-bottom: var(--rw-space-sm);
    color: var(--rw-color-paper-100);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.status-label,
.subtitle-label {
    color: var(--rw-color-paper-shadow-250);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.status-label--hero {
    font-size: 19px;
}

.menu-poster-strip {
    width: 100%;
    height: 44px;
    margin-bottom: var(--rw-space-md);
    justify-content: center;
    align-items: center;
    background-color: var(--rw-color-coral-500);
}

.menu-poster-strip__text {
    font-size: 22px;
}

.menu-card,
.template-selection-card,
.dialog-page__content {
    width: 100%;
    max-width: 390px;
    padding: var(--rw-space-lg);
    background-color: var(--rw-color-paper-100);
    border-top-width: var(--rw-border-strong);
    border-right-width: var(--rw-border-strong);
    border-bottom-width: var(--rw-border-strong);
    border-left-width: var(--rw-border-strong);
    border-top-color: var(--rw-color-paper-shadow-250);
    border-right-color: var(--rw-color-paper-shadow-250);
    border-bottom-color: var(--rw-color-paper-shadow-250);
    border-left-color: var(--rw-color-paper-shadow-250);
}

.menu-card .brand-title,
.template-screen-title,
.template-detail-title,
.dialog-title {
    color: var(--rw-color-ink-900);
}

.menu-card .subtitle-label,
.template-screen-subtitle,
.template-detail-summary,
.template-detail-emphasis,
.dialog-body {
    color: var(--rw-color-ink-muted);
    white-space: normal;
}

.menu-card .brand-title {
    font-size: 42px;
}

.menu-card .subtitle-label {
    margin-bottom: var(--rw-space-md);
}

.primary-button,
.secondary-button,
.ghost-button {
    width: 100%;
    min-height: var(--rw-touch-target);
    margin-top: var(--rw-space-sm);
    color: var(--rw-color-paper-100);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.primary-button {
    color: var(--rw-color-paper-100);
    background-color: var(--rw-color-coral-500);
}

.primary-button .unity-button__text {
    color: var(--rw-color-paper-100);
}

.secondary-button {
    color: var(--rw-color-paper-100);
    background-color: var(--rw-color-charcoal-850);
}

.secondary-button .unity-button__text {
    color: var(--rw-color-paper-100);
}

.ghost-button {
    color: var(--rw-color-paper-100);
    background-color: var(--rw-color-olive-500);
}

.ghost-button .unity-button__text {
    color: var(--rw-color-paper-100);
}

.template-screen-content {
    width: 100%;
    height: 100%;
    min-height: 0;
    justify-content: center;
    align-items: center;
}

.template-selection-card {
    padding: var(--rw-space-md);
}

.template-screen-title {
    margin-bottom: var(--rw-space-xs);
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.template-screen-subtitle {
    margin-bottom: var(--rw-space-sm);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.template-option-list {
    width: 100%;
    flex-direction: column;
}

.template-option-button {
    width: 100%;
    min-height: 44px;
    margin-top: 0;
    margin-bottom: var(--rw-space-xs);
    padding-left: var(--rw-space-md);
    padding-right: var(--rw-space-md);
    color: var(--rw-color-paper-100);
    background-color: var(--rw-color-charcoal-850);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.template-option-button--selected {
    background-color: var(--rw-color-coral-500);
}

.template-detail-card {
    margin-top: var(--rw-space-sm);
    padding: var(--rw-space-sm) var(--rw-space-md);
    background-color: var(--rw-color-paper-bright);
    border-left-width: 4px;
    border-left-color: var(--rw-color-olive-500);
}

.template-detail-title {
    font-size: 18px;
    -unity-font-style: bold;
}

.template-detail-tagline {
    margin-top: var(--rw-space-xs);
    color: var(--rw-color-burgundy-650);
    font-size: 14px;
    -unity-font-style: bold;
}

.template-detail-summary,
.template-detail-emphasis {
    margin-top: var(--rw-space-xs);
    font-size: 13px;
}

.template-action-row {
    width: 100%;
    margin-top: var(--rw-space-sm);
    flex-direction: row;
}

.template-action-button {
    width: 50%;
    min-height: var(--rw-touch-target);
    margin-top: 0;
    font-size: 15px;
}

.template-action-button:first-child {
    border-right-width: var(--rw-border-thin);
    border-right-color: var(--rw-color-paper-100);
}

.template-selection-card > .status-label {
    margin-top: var(--rw-space-sm);
    color: var(--rw-color-ink-muted);
    font-size: 13px;
}

.screen--hud {
    flex-direction: column;
}

.hud-content {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    padding-left: var(--rw-space-md);
    padding-right: var(--rw-space-md);
}

.hud-status-deck {
    width: 100%;
    min-height: 86px;
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rw-space-sm);
    background-color: var(--rw-color-charcoal-850);
    border-top-width: var(--rw-border-thin);
    border-right-width: var(--rw-border-thin);
    border-bottom-width: var(--rw-border-thin);
    border-left-width: var(--rw-border-thin);
    border-top-color: var(--rw-color-divider);
    border-right-color: var(--rw-color-divider);
    border-bottom-color: var(--rw-color-divider);
    border-left-color: var(--rw-color-divider);
}

.hud-status-cell {
    width: 16%;
    min-height: 84px;
    padding: var(--rw-space-sm) 6px;
    justify-content: center;
    background-color: var(--rw-color-charcoal-850);
    border-left-width: var(--rw-border-thin);
    border-left-color: var(--rw-color-divider);
}

.hud-status-cell--date {
    width: 20%;
    border-left-width: 0;
}

.hud-date {
    color: var(--rw-color-paper-shadow-250);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-menu-button {
    display: none;
}

.hud-economy-label {
    margin-bottom: var(--rw-space-xs);
    color: var(--rw-color-paper-shadow-250);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-economy-value {
    color: var(--rw-color-paper-100);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-resource-label {
    margin-bottom: var(--rw-space-xs);
    color: var(--rw-color-paper-shadow-250);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-resource-value {
    color: var(--rw-color-paper-100);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-condition-strip {
    width: 100%;
    min-height: 32px;
    margin-bottom: var(--rw-space-sm);
    padding-left: var(--rw-space-sm);
    padding-right: var(--rw-space-sm);
    flex-direction: row;
    align-items: center;
    background-color: var(--rw-color-charcoal-850);
    border-left-width: 3px;
    border-left-color: var(--rw-color-olive-500);
}

.hud-condition-strip__icon {
    width: 10px;
    height: 10px;
    margin-right: var(--rw-space-xs);
    background-color: var(--rw-color-olive-500);
}

.hud-condition-strip__label {
    flex-grow: 1;
    color: var(--rw-color-paper-shadow-250);
    font-size: 11px;
    -unity-font-style: bold;
}

.hud-condition-strip__meta-label {
    margin-right: var(--rw-space-xs);
    color: var(--rw-color-paper-shadow-250);
    font-size: 10px;
    -unity-font-style: bold;
}

.hud-condition-strip__value {
    color: var(--rw-color-amber-500);
    font-size: 11px;
    -unity-font-style: bold;
}

.hud-home-tableau {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: var(--rw-space-sm);
    padding: var(--rw-space-md);
    flex-direction: column;
    background-color: var(--rw-color-tableau);
    border-left-width: 6px;
    border-left-color: var(--rw-color-coral-500);
}

.hud-tableau-copy {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.hud-location-label {
    margin-bottom: var(--rw-space-xs);
    color: var(--rw-color-paper-shadow-250);
    font-size: 13px;
    -unity-font-style: bold;
}

.hud-title {
    margin-bottom: var(--rw-space-xs);
    color: var(--rw-color-paper-100);
    font-size: 28px;
    -unity-font-style: bold;
}

.hud-title--hidden,
.hud-location-body--hidden {
    display: none;
}

.hud-body {
    color: var(--rw-color-paper-100);
    font-size: 14px;
    white-space: normal;
}

.hud-character-slot {
    flex-grow: 1;
    min-height: 0;
    margin-top: var(--rw-space-sm);
    margin-bottom: var(--rw-space-sm);
    background-color: var(--rw-color-charcoal-850);
    border-top-width: var(--rw-border-thin);
    border-right-width: var(--rw-border-thin);
    border-bottom-width: var(--rw-border-thin);
    border-left-width: var(--rw-border-thin);
    border-top-color: var(--rw-color-divider);
    border-right-color: var(--rw-color-divider);
    border-bottom-color: var(--rw-color-divider);
    border-left-color: var(--rw-color-divider);
}

.hud-opportunity-card {
    margin-top: var(--rw-space-sm);
    padding: var(--rw-space-sm) var(--rw-space-md);
    background-color: var(--rw-color-paper-100);
}

.hud-opportunity-label {
    margin-bottom: var(--rw-space-xs);
    color: var(--rw-color-burgundy-650);
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-opportunity-card .hud-body {
    color: var(--rw-color-ink-900);
    font-size: 14px;
}

.hud-bottom-bar {
    width: 100%;
    padding: var(--rw-space-sm) var(--rw-space-md) 0;
    background-color: var(--rw-color-graphite-950);
    border-top-width: var(--rw-border-thin);
    border-top-color: var(--rw-color-divider);
}

.hud-nav {
    width: 100%;
    flex-direction: row;
}

.hud-action-button {
    width: 100%;
    min-height: 62px;
    margin: 0 0 var(--rw-space-sm);
    color: var(--rw-color-paper-100);
    font-size: 13px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-action-button--primary {
    color: var(--rw-color-paper-100);
    background-color: var(--rw-color-action-primary);
    border-top-width: var(--rw-border-thin);
    border-right-width: var(--rw-border-thin);
    border-bottom-width: var(--rw-border-thin);
    border-left-width: var(--rw-border-thin);
    border-top-color: var(--rw-color-action-primary-border);
    border-right-color: var(--rw-color-action-primary-border);
    border-bottom-color: var(--rw-color-action-primary-border);
    border-left-color: var(--rw-color-action-primary-border);
}

.hud-action-button--primary .unity-button__text {
    color: var(--rw-color-paper-100);
}

.hud-action-button--secondary {
    color: var(--rw-color-ink-900);
    background-color: var(--rw-color-paper-100);
}

.hud-action-button--secondary .unity-button__text {
    color: var(--rw-color-ink-900);
}

.hud-nav {
    min-height: var(--rw-touch-target);
    background-color: var(--rw-color-charcoal-850);
}

.hud-nav-item {
    width: 25%;
    color: var(--rw-color-paper-shadow-250);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-nav-item--active {
    color: var(--rw-color-coral-500);
}

.dialog-title {
    margin-bottom: var(--rw-space-sm);
    font-size: 26px;
    -unity-font-style: bold;
}

.dialog-body {
    font-size: 16px;
}

.dialog-actions {
    margin-top: var(--rw-space-lg);
}

.dialog-actions > .unity-button {
    margin-bottom: var(--rw-space-sm);
}
