.app-shell,
.activity-root {
    --rw-color-graphite-950: #181A1B;
    --rw-color-charcoal-850: #242729;
    --rw-color-paper-100: #F2E7D5;
    --rw-color-paper-bright: #FFF8EB;
    --rw-color-paper-shadow-250: #D4C1A4;
    --rw-color-ink-900: #202223;
    --rw-color-ink-muted: #3A3C3D;
    --rw-color-coral-500: #F04F4A;
    --rw-color-action-primary: #C96A50;
    --rw-color-action-primary-border: #F2E7D5;
    --rw-color-olive-500: #78815A;
    --rw-color-amber-500: #D8943B;
    --rw-color-burgundy-650: #7A3541;
    --rw-color-tableau: #413A31;
    --rw-color-divider: #4E4C44;
    --rw-color-overlay: rgba(0, 0, 0, 0.72);

    --rw-space-xs: 4px;
    --rw-space-sm: 8px;
    --rw-space-md: 12px;
    --rw-space-lg: 16px;
    --rw-space-xl: 24px;
    --rw-space-2xl: 32px;

    --rw-radius-sm: 6px;
    --rw-radius-md: 12px;
    --rw-radius-lg: 18px;
    --rw-border-thin: 1px;
    --rw-border-strong: 2px;
    --rw-touch-target: 48px;

    --rw-font-size-caption: 13px;
    --rw-font-size-body: 17px;
    --rw-font-size-action: 19px;
    --rw-font-size-resource: 18px;
    --rw-font-size-title: 40px;
    --rw-font-size-display: 58px;
}
