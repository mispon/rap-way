<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="DesignTokens.uss" />
    <Style src="AppShell.uss" />
    <ui:VisualElement name="safe-area-frame" class="app-shell">
        <ui:VisualElement name="screen-splash" class="screen screen--centered screen--splash">
            <ui:VisualElement class="splash-mark"><ui:Label text="RW" class="splash-mark__text" /></ui:VisualElement>
            <ui:Label text="" class="brand-title" />
            <ui:Label text="" class="status-label status-label--hero" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-main-menu" class="screen screen--centered screen--menu" style="display: none;">
            <ui:VisualElement class="menu-poster-strip"><ui:Label text="RAP WAY" class="menu-poster-strip__text" /></ui:VisualElement>
            <ui:VisualElement class="menu-card">
                <ui:Label text="" class="brand-title" />
                <ui:Label text="" class="subtitle-label" />
                <ui:Button name="new-career-button" text="" class="primary-button" />
                <ui:Button name="continue-button" text="" class="secondary-button" />
                <ui:Button name="quit-button" text="" class="ghost-button" />
                <ui:Label name="main-menu-status-label" text="" class="status-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-new-career-template" class="screen screen--centered" style="display: none;">
            <ui:VisualElement class="template-screen-content">
                <ui:VisualElement class="template-selection-card">
                    <ui:Label text="" class="template-screen-title" />
                    <ui:Label text="" class="template-screen-subtitle" />
                    <ui:VisualElement class="template-option-list">
                        <ui:Button name="template-on-your-own-button" class="template-option-button" />
                        <ui:Button name="template-at-rock-bottom-button" class="template-option-button" />
                        <ui:Button name="template-privileged-start-button" class="template-option-button" />
                        <ui:Button name="template-one-meme-wonder-button" class="template-option-button" />
                        <ui:Button name="template-basement-genius-button" class="template-option-button" />
                        <ui:Button name="template-former-group-member-button" class="template-option-button" />
                        <ui:Button name="template-protege-button" class="template-option-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="template-detail-card">
                        <ui:Label name="template-detail-title" text="" class="template-detail-title" />
                        <ui:Label name="template-detail-tagline" text="" class="template-detail-tagline" />
                        <ui:Label name="template-detail-summary" text="" class="template-detail-summary" />
                        <ui:Label name="template-detail-emphasis" text="" class="template-detail-emphasis" />
                    </ui:VisualElement>
                    <ui:VisualElement class="template-action-row">
                        <ui:Button name="template-back-button" text="" class="ghost-button template-action-button" />
                        <ui:Button name="template-confirm-button" text="" class="primary-button template-action-button" />
                    </ui:VisualElement>
                    <ui:Label name="new-career-status-label" text="" class="status-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-hud" class="screen screen--hud" style="display: none;">
            <ui:VisualElement class="hud-content">
                <ui:VisualElement class="hud-status-deck">
                    <ui:VisualElement class="hud-status-cell hud-status-cell--date">
                        <ui:Label name="hud-date-label" class="hud-date" />
                        <ui:Button name="hud-menu-button" text="" class="hud-menu-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-status-cell">
                        <ui:Label name="hud-money-label" class="hud-economy-label" />
                        <ui:Label name="hud-money-value" class="hud-economy-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-status-cell">
                        <ui:Label name="hud-fans-label" class="hud-economy-label" />
                        <ui:Label name="hud-fans-value" class="hud-economy-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-status-cell"><ui:Label name="hud-energy-label" class="hud-resource-label" /><ui:Label name="hud-energy-value" class="hud-resource-value" /></ui:VisualElement>
                    <ui:VisualElement class="hud-status-cell"><ui:Label name="hud-satiety-label" class="hud-resource-label" /><ui:Label name="hud-satiety-value" class="hud-resource-value" /></ui:VisualElement>
                    <ui:VisualElement class="hud-status-cell"><ui:Label name="hud-motivation-label" class="hud-resource-label" /><ui:Label name="hud-motivation-value" class="hud-resource-value" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hud-condition-strip">
                    <ui:VisualElement class="hud-condition-strip__icon" />
                    <ui:Label name="hud-conditions-status-label" class="hud-condition-strip__label" />
                    <ui:Label name="hud-hype-label" class="hud-condition-strip__meta-label" />
                    <ui:Label name="hud-hype-value" class="hud-condition-strip__value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-home-tableau">
                    <ui:VisualElement class="hud-tableau-copy">
                        <ui:Label name="hud-location-label" class="hud-location-label" />
                        <ui:Label text="" class="hud-title hud-title--hidden" />
                        <ui:Label name="hud-location-body" text="" class="hud-body hud-location-body--hidden" />
                        <ui:VisualElement class="hud-character-slot" />
                        <ui:VisualElement class="hud-opportunity-card">
                            <ui:Label name="hud-opportunity-label" class="hud-opportunity-label" />
                            <ui:Label name="hud-opportunity-body" text="" class="hud-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-bottom-bar">
                <ui:Button name="hud-action-button" class="hud-action-button hud-action-button--primary" />
                <ui:VisualElement class="hud-nav">
                    <ui:Label name="hud-nav-home" class="hud-nav-item hud-nav-item--active" />
                    <ui:Label name="hud-nav-map" class="hud-nav-item" />
                    <ui:Label name="hud-nav-career" class="hud-nav-item" />
                    <ui:Label name="hud-nav-inbox" class="hud-nav-item" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-dialog" class="screen screen--centered screen--dialog" style="display: none;">
            <ui:VisualElement class="dialog-page__content">
                <ui:Label name="dialog-title" text="" class="dialog-title" />
                <ui:Label name="dialog-body" text="" class="dialog-body" />
                <ui:VisualElement name="dialog-actions" class="dialog-actions" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
