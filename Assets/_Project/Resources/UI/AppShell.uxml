<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="safe-area-frame" class="app-shell">
        <ui:VisualElement name="screen-splash" class="screen screen--centered">
            <ui:VisualElement class="hero-card">
                <ui:Label text="Rap Way" class="brand-title" />
                <ui:Label text="Preparing the stage..." class="status-label status-label--hero" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-main-menu" class="screen screen--centered" style="display: none;">
            <ui:VisualElement class="menu-card">
                <ui:Label text="Rap Way" class="brand-title" />
                <ui:Label text="Build your name from the ground up." class="subtitle-label" />
                <ui:Button name="new-career-button" text="New Career" class="primary-button" />
                <ui:Button name="continue-button" text="Continue" class="secondary-button" />
                <ui:Button name="quit-button" text="Quit" class="ghost-button" />
                <ui:Label name="status-label" text="" class="status-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-hud" class="screen screen--hud" style="display: none;">
            <ui:VisualElement class="hud-card">
                <ui:Label text="Session HUD Placeholder" class="hud-title" />
                <ui:Label text="Stage 4 shell is active." class="hud-body" />
            </ui:VisualElement>
            <ui:Button name="hud-menu-button" text="Menu" class="secondary-button hud-menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="modal-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-card">
                <ui:Label name="modal-title" text="" class="modal-title" />
                <ui:Label name="modal-body" text="" class="modal-body" />
                <ui:Button name="modal-primary-button" text="" class="primary-button" />
                <ui:Button name="modal-secondary-button" text="Close" class="ghost-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
