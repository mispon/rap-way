  m_TableData:
  - m_Id: 1039130624
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430 \u0438 \u0440\u0438\u0442\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1114628096
    m_Localized: "\u042D\u043D\u0435\u0440\u0433\u0438\u044F {energy} \u2022 \u0421\u044B\u0442\u043E\u0441\u0442\u044C
      {satiety} \u2022 \u041C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044F {motivation}
      \u2022 \u0414\u0435\u043D\u044C\u0433\u0438 {money}"
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1118822400
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0443
      \u0438 \u043D\u0430\u0447\u043D\u0438\u0442\u0435 \u0441\u043C\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016704
    m_Localized: "{title}: {elapsed}/{duration} \u0447."
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016705
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u043C\u0435\u043D\u0443
      \u043D\u0430 {duration} \u0447."
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016706
    m_Localized: "\u041E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0435\u0449\u0451
      \u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1123016707
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u043C\u0435\u043D\u0443
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C {payment}"
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016708
    m_Localized: "\u041E\u043F\u043B\u0430\u0442\u0430 {payment} / \u0447."
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016709
    m_Localized: "\u041E\u043F\u044B\u0442: {experience}"
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016710
    m_Localized: "\u0418\u0433\u0440\u043E\u0432\u0430\u044F \u0441\u0435\u0441\u0441\u0438\u044F
      \u0435\u0449\u0451 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016711
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E:
      {failure}"
    m_Metadata:
      m_Items:
      - rid: 6869663385489506304
  - m_Id: 1123016712
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10740911038464
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0441\u0438\u043B\u044B, \u043D\u043E
      \u0434\u0430\u0451\u0442 \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043E\u043F\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10741003313152
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
