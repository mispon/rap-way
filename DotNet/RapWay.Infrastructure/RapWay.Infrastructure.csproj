<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RapWay.Infrastructure</AssemblyName>
    <RootNamespace>RapWay.Infrastructure</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Code/Infrastructure/**/*.cs" LinkBase="Infrastructure" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MessagePipe" Version="1.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <ProjectReference Include="../RapWay.Domain/RapWay.Domain.csproj" />
    <ProjectReference Include="../RapWay.Application/RapWay.Application.csproj" />
  </ItemGroup>
</Project>
